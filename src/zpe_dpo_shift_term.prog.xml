       <TDLINE>&amp;TITLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Program pro posun termínu pro Projednání s odbory</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Program projde aktivní žádosti a ty, které nesplňují požadavky, přesune</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>na další termín.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Program běží denně ve 14:00.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;INTEGRATION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Program běží ve třech krocích:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>1. Program načte z tabulek ZHR_DPO_ZAD a ZHR_DPO_TERM všechny žádosti ve</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>statusech:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>&quot;Ve zpracování OJ&quot;,</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>&quot;Ve schvalování OJ&quot;,</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>&quot;Ve schvalování HRBP&quot;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>které mají prošlé &quot;Datum odeslání podkladů na SP&quot; a přesune je na</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>nejbližší volný termín.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>2. Program načte z tabulek ZHR_DPO_ZAD a ZHR_DPO_TERM všechny žádosti ve</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>statusech:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>&quot;Ve zpracování SP&quot;&lt;(&gt;,&lt;)&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,&quot;Schváleno SP&quot;&lt;(&gt;,&lt;)&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,&quot;Schváleno Vedoucím SP&quot;&lt;(&gt;,&lt;)&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>které mají prošlé &quot;Datum odeslání na odbory&quot; a přesune je na nejbližší</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>volný termín.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>3. Program najde všechny žádosti s nekompletním číslem žádosti, nebo</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>neuložené žádosti bez vygenerovaného čísla a smaže je.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,Např. /2025/C - chýbí číselník pro daný rok.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,</TDLINE>
      </TLINE>
      <TLINE>
